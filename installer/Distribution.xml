<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Vocal Rider VST</title>
    <options customize="never" require-scripts="false" rootVolumeOnly="false" hostArchitectures="arm64"/>
    <domains enable_localSystem="true" enable_currentUserHome="true" enable_anywhere="false"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="choiceVocalRider"/>
    </choices-outline>
    <choice id="choiceVocalRider" title="Vocal Rider VST" visible="false">
        <pkg-ref id="com.openrider.vocalridervst"/>
    </choice>
    <pkg-ref id="com.openrider.vocalridervst" version="1.0.0" onConclusion="none">VocalRiderVST.pkg</pkg-ref>
</installer-gui-script>
